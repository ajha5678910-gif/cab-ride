{
  "appId": "com.uber.mobility.app",
  "appName": "Uber Clone",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://cab-ride-six.vercel.app/",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000"
    },
    "Geolocation": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    }
  }
}
